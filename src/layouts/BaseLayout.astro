---
export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  pubDate?: string;
  updatedDate?: string;
  author?: string;
}

const { title, description, image = '/og-default.jpg', article = false, pubDate, updatedDate, author = 'CelebrityTweets Editorial' } = Astro.props;
const siteUrl = 'https://celebritytweets.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = title === 'CelebrityTweets' ? title : `${title} | CelebrityTweets`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:site_name" content="CelebrityTweets" />
    {pubDate && <meta property="article:published_time" content={pubDate} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />
    <meta name="twitter:site" content="@CelebTweets" />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="SJ_vKN7ikuzeBCEOKq4XJUsW6-2pnOVg3_fH3Ivs8XM" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

    <!-- X/Twitter embed widget (loaded once globally) -->
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
  </head>

  <body>
    <!-- Header -->
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">⭐ CelebrityTweets</a>
        <nav>
          <a href="/">Home</a>
          <a href="/category/feuds">Feuds</a>
          <a href="/category/drama">Drama</a>
          <a href="/category/shade">Shade</a>
          <a href="/throwback-thursday">Throwbacks</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} CelebrityTweets.com · Celebrity gossip & tweet drama</p>
        <nav class="footer-nav">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/sitemap.xml">Sitemap</a>
        </nav>
        <p class="disclaimer">We are not affiliated with any celebrities or social media platforms. All tweets are public content embedded via official X/Twitter embed codes. We verify tweets before publishing.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --blue: #89CFF0;
    --blue-dark: #4A90D9;
    --red: #E87070;
    --white: #FFFFFF;
    --black: #1A1A1A;
    --gray: #F5F5F5;
    --gray-mid: #E0E0E0;
    --text: #2C2C2C;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--white);
    color: var(--text);
    line-height: 1.6;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Header */
  .site-header {
    background: var(--blue-dark);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .site-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo {
    font-family: 'Poppins', sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--white);
    text-decoration: none;
    letter-spacing: -0.5px;
  }

  nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  nav a {
    color: rgba(255,255,255,0.9);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  nav a:hover { color: var(--blue); }

  /* Footer */
  .site-footer {
    background: var(--black);
    color: rgba(255,255,255,0.8);
    text-align: center;
    padding: 2rem 0;
    margin-top: 3rem;
    font-size: 0.9rem;
  }
  .footer-nav { display: flex; justify-content: center; gap: 1.5rem; margin: 0.75rem 0; }
  .footer-nav a { color: var(--blue); text-decoration: none; font-size: 0.85rem; }
  .footer-nav a:hover { text-decoration: underline; }
  .disclaimer { font-size: 0.75rem; opacity: 0.6; margin-top: 0.5rem; max-width: 600px; margin-left: auto; margin-right: auto; }

  /* Category Tags */
  .category-tag {
    display: inline-block;
    background: var(--red);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    width: fit-content;
  }
  .category-tag.throwback {
    background: linear-gradient(135deg, #B8860B, #DAA520);
    font-size: 0.75rem;
  }

  /* Utility */
  a { color: var(--blue-dark); }
  img { max-width: 100%; height: auto; }

  @media (max-width: 600px) {
    .logo { font-size: 1.1rem; }
    nav { gap: 0.75rem; }
    nav a { font-size: 0.8rem; }
  }
</style>
