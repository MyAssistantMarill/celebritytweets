---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = post.data.author || 'CelebrityTweets Editorial';
const updatedDate = post.data.updatedDate || post.data.pubDate;

// Related posts: same category first, then recent, exclude current
const allPosts = await getCollection('posts');
const related = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => {
    const sameCategory = (a.data.category === post.data.category ? -1 : 1) - (b.data.category === post.data.category ? -1 : 1);
    if (sameCategory !== 0) return sameCategory;
    return new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf();
  })
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  article={true}
  pubDate={post.data.pubDate}
  updatedDate={updatedDate}
  author={author}
>
  <article class="article-container">

    <header class="article-header">
      <span class="category-tag">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <p class="article-desc">{post.data.description}</p>
      <div class="article-meta">
        <span>✍️ By {author}</span>
        <span>📅 {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        {updatedDate !== post.data.pubDate && <span>🔄 Updated {new Date(updatedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>}
        {post.data.tags && <span class="tags-inline">{post.data.tags.map(t => `#${t}`).join(' ')}</span>}
      </div>
    </header>

    {post.data.image && (
      <img
        src={post.data.image}
        alt={`Featured image for: ${post.data.title}`}
        class="article-hero-img"
        width="780"
        height="420"
        loading="eager"
      />
    )}

    <!-- Mid-article Ad -->
    <div class="ad-mid">
      <ins class="adsbygoogle"
           style="display:block; text-align:center;"
           data-ad-layout="in-article"
           data-ad-format="fluid"
           data-ad-client="ca-pub-4883779928557310"
           data-ad-slot="2222222222"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    <div class="article-body">
      <Content />
    </div>

    {post.data.tags && (
      <div class="tags">
        {post.data.tags.map(tag => <span class="tag">#{tag}</span>)}
      </div>
    )}

    <div class="editorial-note">
      <p>📌 <strong>Editorial policy:</strong> All tweets referenced are verified public posts embedded via official X/Twitter embed codes. <a href="/about">Learn more about how we work.</a></p>
    </div>

  </article>

  <!-- Read Next -->
  {related.length > 0 && (
    <section class="read-next">
      <div class="read-next-inner">
        <h2 class="read-next-title">☕ More Tea</h2>
        <div class="read-next-grid">
          {related.map(p => (
            <a href={`/posts/${p.id}`} class="rn-card">
              {p.data.image && (
                <img src={p.data.image} alt={p.data.title} class="rn-img" width="300" height="170" loading="lazy" />
              )}
              <div class="rn-body">
                <span class={`cat-tag ${p.data.category.toLowerCase().replace(' ', '-')}`}>{p.data.category}</span>
                <h3>{p.data.title}</h3>
                <p class="rn-date">{new Date(p.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Bottom Ad -->
  <div class="ad-bottom">
    <div class="ad-bottom-inner">
      <p class="ad-label">Advertisement</p>
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-4883779928557310"
           data-ad-slot="4444444444"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  </div>

</BaseLayout>

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": new Date(post.data.pubDate).toISOString(),
  "dateModified": new Date(updatedDate).toISOString(),
  "image": post.data.image ? `https://celebritytweets.com${post.data.image}` : `https://celebritytweets.com/og-default.jpg`,
  "author": { "@type": "Organization", "name": author, "url": "https://celebritytweets.com/about" },
  "publisher": {
    "@type": "Organization",
    "name": "CelebrityTweets",
    "url": "https://celebritytweets.com",
    "logo": { "@type": "ImageObject", "url": "https://celebritytweets.com/og-default.jpg", "width": 600, "height": 60 }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://celebritytweets.com/posts/${post.id}` },
  "articleSection": post.data.category,
  "keywords": post.data.tags?.join(', ')
})} />

<style>
  .article-container {
    max-width: 780px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .article-header { margin-bottom: 1.5rem; }
  .article-header h1 {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0.75rem 0 0.5rem;
    color: var(--ink);
    letter-spacing: -0.03em;
  }
  .article-desc { font-size: 1.05rem; color: var(--muted); margin-bottom: 0.75rem; line-height: 1.6; }
  .article-meta { font-size: 0.82rem; color: #9CA3AF; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .tags-inline { color: var(--blue-dark); }

  .article-hero-img { width: 100%; border-radius: var(--radius-md); margin-bottom: 1.5rem; max-height: 420px; object-fit: cover; }

  .ad-mid { margin: 1.5rem 0; }

  .article-body { font-size: 1.05rem; line-height: 1.85; }
  .article-body h2 { font-family: var(--font-head); font-size: 1.4rem; font-weight: 700; margin: 2rem 0 0.75rem; color: var(--blue-dark); }
  .article-body h3 { font-family: var(--font-head); font-size: 1.1rem; font-weight: 700; margin: 1.5rem 0 0.5rem; }
  .article-body p { margin-bottom: 1.25rem; }
  .article-body blockquote { border-left: 4px solid var(--blue); padding-left: 1rem; color: var(--muted); font-style: italic; margin: 1.5rem 0; }
  .article-body a { color: var(--blue-dark); text-decoration: underline; }
  .article-body hr { border: none; border-top: 2px solid var(--border); margin: 2rem 0; }

  .tags { margin-top: 2rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tag { background: var(--blue); color: white; font-size: 0.78rem; padding: 0.25rem 0.75rem; border-radius: 20px; font-weight: 500; }

  .editorial-note { margin-top: 2rem; padding: 1rem 1.1rem; background: var(--surface); border-radius: var(--radius-sm); font-size: 0.82rem; color: var(--muted); border-left: 3px solid var(--blue-mid); }
  .editorial-note a { color: var(--blue-dark); text-decoration: underline; }

  .category-tag { display: inline-block; background: var(--red); color: white; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.22rem 0.65rem; border-radius: 20px; }

  /* ── Read Next ──────────────────────────────────── */
  .read-next {
    background: var(--ink);
    margin-top: 3rem;
    padding: 2.5rem 0;
  }
  .read-next-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .read-next-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    color: white;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  .read-next-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .rn-card {
    background: #1a1a1a;
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: white;
    border: 1px solid rgba(255,255,255,0.07);
    transition: transform 0.2s, border-color 0.2s;
    display: flex;
    flex-direction: column;
  }
  .rn-card:hover { transform: translateY(-3px); border-color: var(--blue); }
  .rn-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; opacity: 0.9; }
  .rn-body { padding: 0.9rem 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .rn-body h3 { font-family: var(--font-head); font-size: 0.9rem; font-weight: 700; line-height: 1.35; color: rgba(255,255,255,0.92); }
  .rn-date { font-size: 0.72rem; color: rgba(255,255,255,0.4); margin-top: auto; padding-top: 0.4rem; }

  /* ── Bottom Ad ──────────────────────────────────── */
  .ad-bottom { background: var(--surface); border-top: 1px solid var(--border); padding: 1.5rem 0 2rem; }
  .ad-bottom-inner { max-width: 1160px; margin: 0 auto; padding: 0 1.25rem; }
  .ad-label { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: #9CA3AF; margin-bottom: 0.5rem; text-align: center; }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 900px) {
    .read-next-grid { grid-template-columns: 1fr 1fr; }
    .read-next-grid .rn-card:last-child { display: none; }
  }
  @media (max-width: 600px) {
    .article-header h1 { font-size: 1.55rem; }
    .read-next-grid { grid-template-columns: 1fr; }
    .read-next-grid .rn-card:last-child { display: flex; }
  }
</style>
